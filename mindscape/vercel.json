{
  "version": 2,
  "builds": [
    {
      "src": "backend/main.py",
      "use": "@vercel/python"
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "media/**",
      "use": "@vercel/static"
    },
    {
      "src": "fonts/**",
      "use": "@vercel/static"
    },
    {
      "src": "src/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/main.py"
    },
    {
      "src": "/api",
      "dest": "backend/main.py"
    },
    {
      "src": "/portal",
      "dest": "portal.html"
    },
    {
      "src": "/admin",
      "dest": "portal.html"
    },
    {
      "src": "/about",
      "dest": "index.html"
    },
    {
      "src": "/register",
      "dest": "index.html"
    },
    {
      "src": "/submit",
      "dest": "index.html"
    },
    {
      "src": "/prize-pool",
      "dest": "index.html"
    },
    {
      "src": "/prizes",
      "dest": "index.html"
    },
    {
      "src": "/rules",
      "dest": "index.html"
    },
    {
      "src": "/faq",
      "dest": "index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
